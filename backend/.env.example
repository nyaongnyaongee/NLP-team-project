# 이 파일을 .env 로 복사해 값을 채운다. .env 는 git 에 올리지 않는다.
#
# Mac (Homebrew PostgreSQL): Mac 사용자 이름으로 비밀번호 없이 접속된다 (whoami 로 확인)
#   DATABASE_URL=postgresql+psycopg://Mac사용자이름@localhost:5432/eum
# Windows (공식 설치 프로그램): 사용자 postgres, 설치할 때 정한 비밀번호
#   DATABASE_URL=postgresql+psycopg://postgres:비밀번호@localhost:5432/eum
DATABASE_URL=postgresql+psycopg://Mac사용자이름@localhost:5432/eum
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# 아무 긴 문자열 (Mac: openssl rand -hex 32 / Windows: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=
