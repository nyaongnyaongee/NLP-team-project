# 이 파일을 .env 로 복사해 값을 채운다. .env 는 git 에 올리지 않는다.
# DATABASE_URL 은 아래 두 줄 중 자기 환경에 맞는 것 하나만 쓴다.
#
# Windows (공식 설치 프로그램): 사용자 postgres + 설치할 때 정한 비밀번호
#   DATABASE_URL=postgresql+psycopg://postgres:비밀번호@localhost:5432/eum
# Mac (Homebrew): Mac 사용자 이름, 비밀번호 없음 (터미널에서 whoami 로 확인)
#   DATABASE_URL=postgresql+psycopg://Mac사용자이름@localhost:5432/eum
#
# 이 줄을 위 예시로 바꿔 쓴다 (바꾸기 전에는 dev.py 가 켜지지 않는다)
DATABASE_URL=postgresql+psycopg://postgres:비밀번호@localhost:5432/eum

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# 아무 긴 문자열. 만드는 법:
#   Windows: .venv\Scripts\python -c "import secrets; print(secrets.token_hex(32))"
#   Mac:     openssl rand -hex 32
JWT_SECRET=
